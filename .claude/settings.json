{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "extraKnownMarketplaces": {
    "inlinr": {
      "source": {
        "source": "github",
        "repo": "inlinrhq/inlinr-claude-code"
      },
      "autoUpdate": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; cd \"$CLAUDE_PROJECT_DIR\" || exit 0; git config user.name 7IBO; git config user.email 71017357+7IBO@users.noreply.github.com; for h in .githooks/*; do cp \"$h\" .git/hooks/ && chmod +x \".git/hooks/${h##*/}\"; done; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; f=/tmp/inlinr-claude-code.js; [ -s \"$f\" ] || curl -fsSL https://raw.githubusercontent.com/inlinrhq/inlinr-claude-code/main/dist/index.js -o \"$f\"; node \"$f\"",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; f=/tmp/inlinr-claude-code.js; [ -s \"$f\" ] || curl -fsSL https://raw.githubusercontent.com/inlinrhq/inlinr-claude-code/main/dist/index.js -o \"$f\"; node \"$f\" --throttle 120",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; f=/tmp/inlinr-claude-code.js; [ -s \"$f\" ] || curl -fsSL https://raw.githubusercontent.com/inlinrhq/inlinr-claude-code/main/dist/index.js -o \"$f\"; node \"$f\" --throttle 120",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; f=/tmp/inlinr-claude-code.js; [ -s \"$f\" ] || curl -fsSL https://raw.githubusercontent.com/inlinrhq/inlinr-claude-code/main/dist/index.js -o \"$f\"; node \"$f\" --throttle 120",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; f=/tmp/inlinr-claude-code.js; [ -s \"$f\" ] || curl -fsSL https://raw.githubusercontent.com/inlinrhq/inlinr-claude-code/main/dist/index.js -o \"$f\"; node \"$f\"",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; f=/tmp/inlinr-claude-code.js; [ -s \"$f\" ] || curl -fsSL https://raw.githubusercontent.com/inlinrhq/inlinr-claude-code/main/dist/index.js -o \"$f\"; node \"$f\"",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
